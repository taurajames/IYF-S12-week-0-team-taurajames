<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Box Model Practice</title>

    <link rel="stylesheet" href="styles.css">

    <style>
        /* Exercise 1: The four layers of the box model */

        .box {
            width: 200px;
            background: #ffe08a;
            content: none;
        }

        .with-padding {
            padding: 24px;
        }

        .with-border {
            padding: 24px;
            border: 4px solid;
        }

        .with-margin {
            padding: 24px;
            border: 4px solid;
            margin: 32px;
        }

        /* Exercise 2: Broken box */

        .broken-box {
            width: 300px;
            padding: 20px;
            border: 1px solid;
            background: #ffe08a;
            box-sizing: border-box;
        }

        /* Exercise 3: Card */

        .card {
            width: 300px;
            padding: 20px;
            border: 1px solid gray;
        }

        .card img {
            width: 100%;
        }

        .card h3 {
            margin-bottom: 15px;
        }
    </style>
</head>

<body>

    <h1>Box Model Practice</h1>

    <h2>Exercise 1: The four layers</h2>

    <div class="box content-only">Content</div>
    <div class="box with-padding">Padding</div>
    <div class="box with-border">Border</div>
    <div class="box with-margin">Margin</div>

    <h2>Exercise 2: The broken box</h2>

    <div class="broken-box">
        This box should be 300px wide.
    </div>

    <h2>Exercise 3: The card</h2>

    <article class="card">
        <img src="https://placehold.co/258x150" alt="Project screenshot placeholder">
        <h3>My Project</h3>
        <p>This is a short description of my project.</p>
        <button type="button">View project</button>
    </article>

</body>
</html>
